{
  "name": "isaac-sim",
  "description": "Complete NVIDIA Isaac Sim v5.1.0 knowledge combining official documentation and GitHub codebase. Use for robot simulation, synthetic data generation, Isaac Lab, ROS 2 integration, debugging Isaac Sim issues, and understanding implementation details.",
  "merge_mode": "rule-based",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://docs.isaacsim.omniverse.nvidia.com/5.1.0/",
      "extract_api": true,
      "selectors": {
        "main_content": "main#main-content",
        "title": "h1",
        "code_blocks": "pre"
      },
      "url_patterns": {
        "include": [
          "/installation/",
          "/introduction/",
          "/overview/",
          "/isaac_lab_tutorials/",
          "/ros2_tutorials/",
          "/replicator_tutorials/",
          "/synthetic_data_generation/",
          "/action_and_event_data_generation/",
          "/assets/",
          "/api/",
          "/reference/"
        ],
        "exclude": [
          "/search.html",
          "/genindex.html",
          "/_static/",
          "/_sources/",
          "/common/feedback",
          "/common/general-feedback"
        ]
      },
      "categories": {
        "getting_started": ["index", "introduction", "quickstart", "tutorial"],
        "installation": ["installation", "install", "setup", "requirements"],
        "isaac_lab": ["isaac_lab", "lab"],
        "ros2": ["ros2", "ros"],
        "simulation": ["simulation", "physics", "robot"],
        "synthetic_data": ["replicator", "synthetic", "perception"],
        "assets": ["assets", "usd"],
        "api": ["api", "reference", "python"],
        "troubleshooting": ["troubleshooting", "known_issues", "faq"]
      },
      "rate_limit": 0.5,
      "max_pages": 800
    },
    {
      "type": "github",
      "repo": "isaac-sim/IsaacSim",
      "branch": "v5.1.0",
      "include_issues": true,
      "max_issues": 150,
      "include_changelog": true,
      "include_releases": true,
      "include_code": true,
      "code_analysis_depth": "surface",
      "file_patterns": [
        "exts/**/*.py",
        "standalone_examples/**/*.py",
        "*.md",
        "*.rst"
      ],
      "exclude_patterns": [
        "**/__pycache__/**",
        "**/.git/**",
        "**/build/**",
        "**/dist/**",
        "**/*.pyc"
      ]
    }
  ]
}
